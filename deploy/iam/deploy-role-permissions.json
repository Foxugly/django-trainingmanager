{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendCommandToInstanceAndDoc",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:eu-west-1:362629935151:instance/i-0fe664678563bae5f",
        "arn:aws:ssm:eu-west-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadCommandResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}

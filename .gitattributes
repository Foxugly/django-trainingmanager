# Force LF on everything that executes or is parsed on the Linux box — a CRLF
# shebang or unit line breaks on Ubuntu. Committed from a Windows PC, so be explicit.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf

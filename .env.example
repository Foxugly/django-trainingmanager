# Example env for local dev. Copy to .env (gitignored) and adjust.
# In prod these come from SSM /trainingmanager/prod/* → /run/trainingmanager/.env
# (systemd EnvironmentFile). Bare names (no DJANGO_ prefix) — OPERATIONS.md §3.5.

SECRET_KEY=dev-insecure-change-me
DEBUG=True
STATE=INT
WEBSITE=wp.foxugly.com
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Optional — sqlite is the default if unset.
# DATABASE_URL=sqlite:///db.sqlite3

# Prod-only knobs (ignored when DEBUG=True):
# SECURE_SSL_REDIRECT=True
# HSTS_SECONDS=31536000
# HSTS_INCLUDE_SUBDOMAINS=True
# HSTS_PRELOAD=True

# Opt-in error tracking (leave empty to disable):
# SENTRY_DSN=
